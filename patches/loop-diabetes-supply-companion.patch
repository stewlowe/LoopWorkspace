+    /// Publishes only the read-only status values used by Diabetes Supply Companion.
+    private func exportCGMSupplyLifecycle(_ manager: CGMManager?) {
+        guard let manager = manager,
+              manager.pluginIdentifier == "G7CGMManager",
+              let defaults = UserDefaults.appGroup,
+              let activatedAt = manager.rawState["activatedAt"] as? Date
+        else {
+            return
+        }
+
+        defaults.set(activatedAt, forKey: SupplyCompanionDefaultsKey.sensorActivatedAt)
+        if let sensorIdentifier = manager.rawState["sensorID"] as? String {
+            defaults.set(sensorIdentifier, forKey: SupplyCompanionDefaultsKey.sensorIdentifier)
+        }
+    }
+
+    private func exportPumpSupplyLifecycle(_ manager: PumpManager?) {
+        guard let manager = manager,
+              manager.pluginIdentifier == "Omni",
+              let defaults = UserDefaults.appGroup,
+              let podState = manager.rawState["podState"] as? [String: Any],
+              let activatedAt = podState["activatedAt"] as? Date
+        else {
+            return
+        }
+
+        let previousActivatedAt = defaults.object(forKey: SupplyCompanionDefaultsKey.podActivatedAt) as? Date
+        defaults.set(activatedAt, forKey: SupplyCompanionDefaultsKey.podActivatedAt)
+        if let expiresAt = podState["expiresAt"] as? Date {
+            defaults.set(expiresAt, forKey: SupplyCompanionDefaultsKey.podExpiresAt)
+        }
+
+        if !exportPumpReservoir(manager), previousActivatedAt != activatedAt {
+            defaults.removeObject(forKey: SupplyCompanionDefaultsKey.reservoirUnits)
+            defaults.removeObject(forKey: SupplyCompanionDefaultsKey.reservoirDate)
+        }
+    }
+
+    private func exportCurrentGlucose() {
+        guard let defaults = UserDefaults.appGroup,
+              let glucose = glucoseStore.latestGlucose
+        else {
+            return
+        }
+
+        let unit = preferredGlucoseUnit
+        defaults.set(glucose.quantity.doubleValue(for: unit), forKey: SupplyCompanionDefaultsKey.glucoseValue)
+        defaults.set(unit == .millimolesPerLiter ? "mmol/L" : "mg/dL", forKey: SupplyCompanionDefaultsKey.glucoseUnit)
+        defaults.set(glucose.startDate, forKey: SupplyCompanionDefaultsKey.glucoseDate)
+    }
+
+    private func exportReservoir(units: Double, at date: Date) {
+        guard let defaults = UserDefaults.appGroup else {
+            return
+        }
+
+        defaults.set(units, forKey: SupplyCompanionDefaultsKey.reservoirUnits)
+        defaults.set(date, forKey: SupplyCompanionDefaultsKey.reservoirDate)
+    }
+
+    /// Omnipod intentionally does not send its usual reservoir delegate callback
+    /// while the level is the special "50+ U" value. Prefer the current Pod's
+    /// persisted status so an old Pod's final reading cannot overwrite it.
+    @discardableResult
+    private func exportPumpReservoir(_ manager: PumpManager?) -> Bool {
+        guard let manager = manager,
+              manager.pluginIdentifier == "Omni",
+              let podState = manager.rawState["podState"] as? [String: Any],
+              let measurements = podState["lastInsulinMeasurements"] as? [String: Any],
+              let reservoirLevel = measurements["reservoirLevel"] as? Double,
+              let validTime = measurements["validTime"] as? Date
+        else {
+            return false
+        }
+
+        exportReservoir(units: reservoirLevel, at: validTime)
+        return true
+    }
+
+    private func exportStoredReservoir() {
+        if exportPumpReservoir(pumpManager) {
+            return
+        }
+
+        guard let reservoir = doseStore.lastReservoirValue else {
+            return
+        }
+
+        exportReservoir(units: reservoir.unitVolume, at: reservoir.startDate)
+    }
